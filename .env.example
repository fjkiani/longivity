# ─────────────────────────────────────────────────────────────────────────────
# Longivity Backend — Environment Variables
# Copy to .env and fill in values. Never commit .env to version control.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (asyncpg driver)
DATABASE_URL=postgresql+asyncpg://longivity:longivity@localhost:5432/longivity

# ── Authentication ────────────────────────────────────────────────────────────
# JWT signing secret — generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-in-production-longivity-2026

# ── CORS ──────────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins. Use * only in development.
# In production (ENV=production), wildcard * is rejected at startup.
ALLOWED_ORIGINS=http://localhost:3000,https://longivity.app

# ── Environment ───────────────────────────────────────────────────────────────
# Set to "production" to enable production-mode checks (CORS lockdown, etc.)
ENV=development

# ── Keep-alive (Render free tier) ─────────────────────────────────────────────
# URL to ping every KEEPALIVE_INTERVAL_SECONDS to prevent cold starts
KEEPALIVE_URL=https://longivity-backend.onrender.com/api/v1/longevity/healthz
KEEPALIVE_INTERVAL_SECONDS=600

# ── Research Intelligence (LLM) ───────────────────────────────────────────────
# OpenRouter API key for LLM-powered evidence synthesis
# Get at: https://openrouter.ai/keys
OPENROUTER_API_KEY=your-openrouter-api-key-here
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# ── Optional: Diffbot (enhanced evidence retrieval) ───────────────────────────
# If not set, falls back to PubMed-only evidence retrieval
DIFFBOT_TOKEN=

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# Default rate limit for all /api/v1/ routes (requests per minute)
# Format: "N/minute" | "N/hour" | "N/second"
RATE_LIMIT_DEFAULT=10/minute

# ── Logging ───────────────────────────────────────────────────────────────────
# Log level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
