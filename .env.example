# ── Database ──────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://user:password@host:5432/longivity

# ── Auth ──────────────────────────────────────────────────────────────────────
JWT_SECRET=change-me-in-production-longivity-2026

# ── CORS ──────────────────────────────────────────────────────────────────────
ALLOWED_ORIGINS=https://your-frontend.onrender.com,http://localhost:3000

# ── Keep-alive (Render free tier) ─────────────────────────────────────────────
KEEPALIVE_URL=https://your-backend.onrender.com/api/v1/longevity/healthz
KEEPALIVE_INTERVAL_SECONDS=600

# ── Research Intelligence Layer ───────────────────────────────────────────────
# Required for live PubMed evidence synthesis
NCBI_USER_EMAIL=your-email@example.com

# Required for Groq LLM synthesis (get key at console.groq.com)
GROQ_API_KEY=gsk_...

# Optional: Diffbot API for enhanced evidence extraction
DIFFBOT_TOKEN=

# ── Demo Environment ──────────────────────────────────────────────────────────
# Key required to call POST /api/v1/demo/reset
DEMO_RESET_KEY=longivity-demo-reset-2026

# ── Frontend (Next.js) ────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=https://your-backend.onrender.com
