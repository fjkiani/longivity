      "condition_threshold": 40,
      "condition_unit": "U/L",
      "severity": "moderate",
      "recommended_panels": ["liver_function_basic", "autoimmune_basic"],
      "recommended_markers": ["ggt_liver", "ast_liver", "alp_liver", "ana_screen", "immunoglobulin_g"],
      "rationale": "ALT >40 U/L warrants full liver function assessment and autoimmune hepatitis screen; GGT helps differentiate alcohol/toxin vs. hepatocellular etiology",
      "hallmark": "mitochondrial_dysfunction",
      "priority": "high",
      "requires_fasting": false,
      "sex_specific": false,
      "sex_threshold_male": null,
      "sex_threshold_female": null
    },
    {
