{
  "_metadata": {
    "version": "1.0.0",
    "created": "2025-01-01",
    "total_rules": 50,
    "description": "Flat list of escalation rules: if a biomarker result meets a condition, recommend ordering additional panels and markers",
    "rule_id_format": "ESC-NNN",
    "severity_levels": ["mild", "moderate", "severe"],
    "priority_levels": ["low", "medium", "high", "urgent"],
    "source_notes": "Thresholds based on clinical guidelines (ADA, ACC/AHA, AACE) with longevity-optimal overlays"
  },
  "rules": [
    {
      "rule_id": "ESC-001",
      "category": "metabolic",
      "trigger_marker": "glucose",
      "condition": "glucose > 100",
      "condition_operator": "gt",
      "condition_threshold": 100,
      "condition_unit": "mg/dL",
      "severity": "moderate",
      "recommended_panels": ["metabolic_markers"],
      "recommended_markers": ["fasting_insulin", "homa_ir", "hba1c", "c_peptide"],
      "rationale": "Fasting glucose >100 mg/dL (impaired fasting glucose) warrants full metabolic assessment including insulin resistance markers",
      "hallmark": "nutrient_sensing",
      "priority": "high",
      "requires_fasting": true,
      "sex_specific": false,
      "sex_threshold_male": null,
      "sex_threshold_female": null
    },
    {
      "rule_id": "ESC-002",
      "category": "metabolic",
      "trigger_marker": "hba1c",
      "condition": "hba1c > 5.7",
      "condition_operator": "gt",
      "condition_threshold": 5.7,
      "condition_unit": "%",
      "severity": "moderate",
      "recommended_panels": ["metabolic_markers", "igf_axis"],
      "recommended_markers": ["fasting_insulin", "homa_ir", "c_peptide", "igf1", "uric_acid"],
      "rationale": "HbA1c >5.7% (prediabetes range) indicates chronic glycemic dysregulation; IGF-1 axis assessment needed to evaluate mTOR/insulin signaling",
      "hallmark": "nutrient_sensing",
      "priority": "high",
      "requires_fasting": true,
      "sex_specific": false,
      "sex_threshold_male": null,
      "sex_threshold_female": null
    },
    {
      "rule_id": "ESC-003",
      "category": "metabolic",
      "trigger_marker": "fasting_insulin",
      "condition": "fasting_insulin > 10",
      "condition_operator": "gt",
      "condition_threshold": 10,
      "condition_unit": "uIU/mL",
      "severity": "moderate",
      "recommended_panels": ["metabolic_markers"],
      "recommended_markers": ["homa_ir", "c_peptide", "uric_acid", "triglycerides"],
      "rationale": "Fasting insulin >10 uIU/mL indicates hyperinsulinemia and insulin resistance; HOMA-IR, C-peptide, and uric acid complete the metabolic picture",
      "hallmark": "nutrient_sensing",
      "priority": "high",
      "requires_fasting": true,
      "sex_specific": false,
      "sex_threshold_male": null,
      "sex_threshold_female": null
    },
    {
      "rule_id": "ESC-004",
      "category": "metabolic",
      "trigger_marker": "homa_ir",
      "condition": "homa_ir > 2.0",
      "condition_operator": "gt",
      "condition_threshold": 2.0,
      "condition_unit": "index",
      "severity": "moderate",
      "recommended_panels": ["metabolic_markers", "advanced_lipids"],
      "recommended_markers": ["c_peptide", "uric_acid", "apob", "sdldl", "triglycerides"],
      "rationale": "HOMA-IR >2.0 indicates significant insulin resistance; advanced lipids needed to assess atherogenic dyslipidemia pattern (high TG, low HDL, small dense LDL)",
      "hallmark": "nutrient_sensing",
      "priority": "high",
      "requires_fasting": true,
      "sex_specific": false,
      "sex_threshold_male": null,
      "sex_threshold_female": null
    },
    {
      "rule_id": "ESC-005",
      "category": "metabolic",
      "trigger_marker": "uric_acid",
      "condition": "uric_acid > sex-specific threshold (F: 6.0, M: 7.0)",
      "condition_operator": "gt",
      "condition_threshold": null,
      "condition_unit": "mg/dL",
      "severity": "moderate",
      "recommended_panels": ["kidney_extended", "metabolic_markers"],
      "recommended_markers": ["cystatin_c", "egfr_cystatin", "urine_albumin_creatinine_ratio", "fasting_insulin", "homa_ir"],
      "rationale": "Elevated uric acid indicates purine metabolism dysregulation, often co-occurring with insulin resistance and early kidney dysfunction",
      "hallmark": "nutrient_sensing",
      "priority": "medium",
      "requires_fasting": false,
      "sex_specific": true,
      "sex_threshold_male": 7.0,
      "sex_threshold_female": 6.0
    },
    {
      "rule_id": "ESC-006",
      "category": "metabolic",
      "trigger_marker": "alt",
      "condition": "alt > 40",
